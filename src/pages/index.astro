---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '../styles/global.css';
import '../styles/scroll-experience.css';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ScrollPhoto from '../components/ScrollPhoto.astro';
import { wedding } from '../content/wedding';
import { googleCalendarUrl } from '../lib/calendar';

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(wedding.address)}`;
const publishedUrl = Astro.site;
const updated = new Intl.DateTimeFormat('fr-CA', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(wedding.updated));
---
<!doctype html>
<html lang="fr-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5ee" />
    <meta name="description" content={wedding.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_CA" />
    <meta property="og:title" content={wedding.title} />
    <meta property="og:description" content={wedding.description} />
    <meta property="og:image" content={publishedUrl ? new URL('/photos/partage.jpg', publishedUrl).href : '/photos/partage.jpg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yassine embrasse Marie-Audrée sur la joue" />
    <meta name="twitter:card" content="summary_large_image" />
    {publishedUrl && <><link rel="canonical" href={publishedUrl} /><meta property="og:url" content={publishedUrl.href} /></>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{wedding.title}</title>
  </head>
  <body>
    <div class="reading-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <header class="site-header">
      <a class="monogram" href="#accueil" aria-label="Yassine et Marie-Audrée, accueil">y<span>&</span>m<span class="monogram-dot">.</span></a>
      <nav aria-label="Navigation principale">
        <a href="#histoire">Notre histoire</a>
        <a href="#weekend">La fin de semaine</a>
        <a href="#infos">Les petits détails</a>
      </nav>
      <a class="header-date" href="#calendrier">On réserve la date <Icon name="northeast" /></a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Ouvrir le menu"><span></span><span></span></button>
    </header>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Navigation mobile" hidden>
      <a href="#histoire">Notre histoire</a><a href="#weekend">La fin de semaine</a><a href="#infos">Les petits détails</a><a href="#calendrier">Réserver la date</a>
    </nav>

    <main id="main">
      <div class="hero-scroll" data-scroll-scene>
      <section id="accueil" class="hero section-wrap hero-stage">
        <div class="hero-copy">
          <p class="eyebrow"><span class="tiny-line"></span> Notre prochaine grande aventure</p>
          <h1>On se<br /><em>marie</em><span class="gold">.</span><Icon name="spark" class="title-spark" /></h1>
          <div class="couple-names"><span>{wedding.names[0]}</span><span class="name-amp">&</span><span>{wedding.names[1]}</span></div>
          <p class="hero-invitation">Et on ne s’imagine pas ça sans vous.</p>
          <a class="button button-dark" href="#calendrier">Réservez votre fin de semaine <Icon name="northeast" /></a>
          <div class="hero-details"><span>{wedding.dates.label}</span><span>{wedding.town}, Québec</span></div>
        </div>
        <div class="hero-art">
          <div class="hero-arch parallax-frame"><Photo id="garden" alt="Yassine et Marie-Audrée partagent un fou rire devant une paroi rocheuse, entourés de verdure" eager class="parallax-image" sizes="(max-width: 700px) 90vw, 48vw" /></div>
          <div class="date-stamp"><span>Beaucoup d’amour</span><strong>09.10<span>2027</span></strong><span>Un grand oui <Icon name="heart" /></span></div>
          <span class="hero-photo-note">le début de la suite.</span>
          <svg class="orbit-line" viewBox="0 0 600 650" fill="none" aria-hidden="true"><ellipse cx="300" cy="325" rx="274" ry="312" transform="rotate(19 300 325)" /></svg>
        </div>
        <span class="hero-endword" aria-hidden="true">oui.</span>
        <a href="#invitation" class="scroll-cue"><span>La suite, c’est par ici</span><Icon name="down" /></a>
      </section>
      </div>

      <div class="ribbon" aria-hidden="true"><span>De l’amour</span><Icon name="spark" /><span>Des amis</span><Icon name="spark" /><span>Une grande aventure</span><Icon name="spark" /><span>Et nous tous, ensemble</span><Icon name="spark" /></div>

      <section id="invitation" class="invitation invitation-scene" data-scroll-scene>
        <div class="invitation-stage">
          <div class="invitation-color-block" aria-hidden="true"></div>
          <span class="type-fragment type-fragment--love" aria-hidden="true">amour</span>
          <ScrollPhoto slot="invitationLeft" class="invitation-photo-left" travel={230} rotate={-3} />
          <ScrollPhoto slot="invitationRight" class="invitation-photo-right" travel={-190} rotate={3} />
          <div class="invitation-text">
        <p class="eyebrow">Vous, nous, et un peu de magie</p>
        <h2>Pas tout à fait un mariage traditionnel. Tout à fait <em>nous.</em></h2>
        <p class="intro-text">{wedding.intro}</p>
        <div class="handwritten">Venez comme vous êtes. On s’occupe de l’amour.</div>
        <Icon name="spark" class="invitation-spark" />
          </div>
        </div>
      </section>

      <section id="histoire" class="story section-wrap" data-scroll-scene>
        <div class="story-photos reveal">
          <div class="story-main parallax-frame"><Photo id="summit" alt="Yassine et Marie-Audrée au sommet d’une montagne" class="parallax-image" /></div>
          <figure class="story-detail-photo" data-story-layer><Photo id="kiss" alt="Un baiser et un sourire lors d’une aventure à deux" sizes="(max-width: 700px) 45vw, 22vw" /></figure>
          <Icon name="spark" class="photo-spark" />
        </div>
        <div class="story-copy reveal">
          <p class="eyebrow">01 / L’histoire derrière le oui</p>
          <h2>80 kilomètres.<br />Et un <em>grand oui.</em></h2>
          <p class="story-lead">{wedding.story[0]}</p>
          {wedding.story.slice(1).map(paragraph => <p>{paragraph}</p>)}
          <div class="race-result"><div><strong>6<sup>e</sup></strong><span>au général</span></div><span class="result-plus">+</span><div><strong>4<sup>e</sup></strong><span>dans sa catégorie</span></div><span class="result-equals">=</span><Icon name="heart" /></div>
          {wedding.storyProof ? <figure class="story-proof"><img src={wedding.storyProof.src} alt={wedding.storyProof.alt} loading="lazy" /><figcaption>La preuve en image.</figcaption></figure> : <div class="proof-placeholder"><Icon name="mountain" /><div><strong>Le destin avait parlé. On a la preuve.</strong><span>La fameuse liste arrive bientôt ici…</span></div></div>}
        </div>
      </section>

      <section id="weekend" class="weekend">
        <div class="weekend-scroll" data-scroll-scene>
          <div class="weekend-stage">
            <ScrollPhoto slot="weekendBackdrop" class="weekend-backdrop" travel={0} sizes="100vw" />
            <div class="weekend-shade" aria-hidden="true"></div>
            <div class="weekend-title">
              <p class="eyebrow">02 / Une parenthèse ensemble</p>
              <h2>Trois jours.<br /><em>Plein de souvenirs.</em></h2>
              <p>Du 8 au 10 octobre 2027.</p>
            </div>
            <span class="weekend-outline" aria-hidden="true">08 — 10</span>
            <ScrollPhoto slot="weekendForeground" class="weekend-foreground" travel={270} rotate={-4} sizes="(max-width: 600px) 48vw, 28vw" />
          </div>
        </div>
        <div class="section-wrap">
          <div class="weekend-intro reveal"><p>Gardez-nous une petite place dans votre automne.</p><Icon name="spark" /></div>
          <div class="schedule">{wedding.schedule.map((day, i) => <article class:list={['day-card', { 'celebration-day': i === 1 }, 'reveal']}><div class="day-top"><span>{day.day}</span><Icon name={day.icon} /></div><div class="day-number">{day.number}<span>octobre</span></div><h3>{day.title}</h3><p>{day.text}</p><span class="day-note">{day.note}</span>{i === 1 && <span class="big-day-label">Le grand jour</span>}</article>)}</div>
          <p class="schedule-footnote">On peaufine les horaires et les activités. Pour l’instant, réservez ces trois jours !</p>
        </div>
      </section>

      <section id="infos" class="practical section-wrap">
        <div class="details-opening" data-scroll-scene>
          <ScrollPhoto slot="detailsTransition" class="details-photo" travel={200} rotate={2} />
          <span class="type-fragment type-fragment--details" aria-hidden="true">vous.</span>
          <div class="section-heading"><div><p class="eyebrow">03 / Les petits détails</p><h2>Pour venir<br /><em>le cœur léger.</em></h2></div><p>Quelques premières infos pour vous projeter.<br />Le reste se dessine, tout doucement.</p></div>
        </div>
        <div class="location-card reveal"><div class="location-illustration" aria-hidden="true"><svg viewBox="0 0 520 260" fill="none"><path d="M-20 190Q90 50 180 140T360 130T550 90M-20 218Q100 95 190 175T380 165T550 135" stroke="currentColor" opacity=".25"/><path d="m90 194 32-60 32 60m-54-18h44m-22-42v86m235-37 25-47 25 47m-43-14h36m-18-33v68" stroke="currentColor"/><path d="M208 186v-66l54-40 54 40v66h-108Zm-15-62 69-52 68 52M246 186v-39h32v39M220 131h14v15h-14m70-15h14v15h-14" stroke="currentColor" stroke-width="2"/><path d="M262 187c-36 20 50 35 7 73" stroke="#ad8b49" stroke-width="2" stroke-dasharray="5 6"/><circle cx="367" cy="65" r="19" stroke="#ad8b49"/><path d="M0 224q120-20 233 0t287-15" stroke="currentColor" opacity=".3"/></svg><span>Un camp, des amis, de l’amour.</span></div><div class="location-copy"><span class="eyebrow"><Icon name="pin" /> Le point de rendez-vous</span><h3>{wedding.town}</h3><address>2311 Rte 148<br />Grenville-sur-la-Rouge, Québec J0V 1B0</address><a class="text-link" href={mapsUrl} target="_blank" rel="noreferrer">Ouvrir l’itinéraire <Icon name="northeast" /></a></div></div>
        <div class="practical-grid">{wedding.practical.map(item => <article class="practical-item reveal"><Icon name={item.icon} /><h3>{item.title}</h3><p>{item.text}</p><span class="status-tag">{item.status}</span></article>)}</div>
        <div class="faq-block reveal"><div><p class="eyebrow">Vous vous demandez peut-être…</p><h3>Les bonnes<br /><em>questions.</em></h3></div><div class="faq-list">{wedding.faq.map(item => <details><summary>{item.question}<Icon name="plus" /></summary><p>{item.answer}</p></details>)}</div></div>
      </section>

      <section id="calendrier" class="calendar-section" data-scroll-scene>
        <ScrollPhoto slot="closingBackdrop" class="closing-backdrop" travel={0} sizes="100vw" />
        <div class="closing-shade" aria-hidden="true"></div>
        <div class="calendar-orbit" aria-hidden="true"></div>
        <div class="section-wrap calendar-inner reveal"><Icon name="spark" class="calendar-spark" /><p class="eyebrow">La prochaine aventure commence ici</p><h2>Il ne manque<br />plus que <em>vous.</em></h2><p>Bloquez la fin de semaine.<br />Pour les beaux souvenirs, on s’en occupe ensemble.</p><div class="calendar-date">8 — 10 <span>octobre</span> 2027</div><div class="calendar-buttons"><a class="button button-dark" href={googleCalendarUrl()} target="_blank" rel="noreferrer"><Icon name="calendar" /> Google Calendar <Icon name="northeast" /></a><a class="button button-outline" href="/invitation.ics" download="mariage-yassine-marie-audree.ics"><Icon name="down" /> Apple / Outlook (.ics)</a></div><span class="calendar-note">Toute la fin de semaine · Célébration le samedi 9 octobre</span></div>
      </section>
      <aside class="updates section-wrap"><div class="update-dot" aria-hidden="true"></div><div><strong>Cette invitation grandit avec nos préparatifs.</strong><p>Horaires, repas, tarifs, jeux… Revenez faire un tour, on ajoutera les détails ici.</p></div><span>Mis à jour le <time datetime={wedding.updated}>{updated}</time></span></aside>
    </main>
    <footer class="site-footer section-wrap"><a class="monogram" href="#accueil" aria-label="Retour en haut">y<span>&</span>m<span class="monogram-dot">.</span></a><p>Fait avec amour. Pour célébrer le nôtre.</p><span>On a hâte de vous voir <Icon name="heart" /></span></footer>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
